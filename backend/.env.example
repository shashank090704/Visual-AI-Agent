PORT=5000
MONGO_URI=mongodb://localhost:27017/visual_ai_agent
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=1500
JWT_SECRET=visual_ai_secret_key_change_in_prod
NODE_ENV=development

# Redis Streams Broker
REDIS_URL=redis://localhost:6379
REDIS_STREAM=screen_raw
REDIS_CONSUMER_GROUP=ai-workers
REDIS_CONSUMER_NAME=worker-1

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=visual-ai-screenshots
MINIO_PUBLIC_URL=http://localhost:9000

# Event TTL (days before raw events are auto-purged from MongoDB)
EVENT_TTL_DAYS=30
